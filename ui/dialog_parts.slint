// Small widgets shared by the cloud-upload and plot popups.
import { Theme } from "theme.slint";

export struct CalDay { day: int, enabled: bool, selected: bool, today: bool }

export component DlgButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 44px;
    border-radius: 8px;
    background: ta.pressed ? #2a3446 : #0b0f16;
    border-width: 1px;
    border-color: root.primary ? #ffffffa8 : #ffffff30;
    Text { text: root.text; color: #ffffff; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Date or time box with the little drop-down triangle (tap to open a list).
export component PickField inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font: 18px;
    callback clicked;
    height: 40px;
    border-radius: 8px; border-width: 1px; border-color: #ffffff38; background: #0b0f16;
    opacity: root.enabled ? 1.0 : 0.45;
    Text { x: 10px; width: parent.width - 28px; text: root.text; color: #ffffff; font-size: root.font; vertical-alignment: center; }
    Path {
        x: parent.width - 18px; y: (parent.height - 5px) / 2; width: 9px; height: 5px;
        viewbox-width: 9; viewbox-height: 5; commands: "M 0 0 L 9 0 L 4.5 5 Z"; fill: #ffffffb0;
    }
    TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Month grid drop-down. Rust (src/cal.rs) fills `days` (42 cells, Monday first, day 0 = empty).
export component CalendarPopup inherits Rectangle {
    in property <string> title;
    in property <bool> can-next: true;
    in property <[CalDay]> days;
    callback month-step(int);
    callback day-picked(int);
    height: 232px;
    border-radius: 8px; border-width: 1px; border-color: #ffffff40; background: #232834;
    drop-shadow-blur: 16px; drop-shadow-color: #00000090;
    property <length> cw: (self.width - 8px) / 7;

    Rectangle {   // previous month
        x: 0; y: 0; width: 40px; height: 32px;
        Path { x: 15px; y: 10px; width: 8px; height: 12px; viewbox-width: 8; viewbox-height: 12;
               commands: "M 7 0 L 1 6 L 7 12"; stroke: #ffffffd0; stroke-width: 1.6px; }
        TouchArea { clicked => { root.month-step(-1); } }
    }
    Text { y: 0; width: parent.width; height: 32px; text: root.title; color: #ffffff;
           font-size: 14px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    Rectangle {   // next month
        x: parent.width - 40px; y: 0; width: 40px; height: 32px;
        opacity: root.can-next ? 1.0 : 0.25;
        Path { x: 17px; y: 10px; width: 8px; height: 12px; viewbox-width: 8; viewbox-height: 12;
               commands: "M 1 0 L 7 6 L 1 12"; stroke: #ffffffd0; stroke-width: 1.6px; }
        TouchArea { enabled: root.can-next; clicked => { root.month-step(1); } }
    }
    for name[i] in ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]: Text {
        x: 4px + i * root.cw; y: 32px; width: root.cw; height: 20px; text: name;
        color: #ffffff80; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
    }
    for d[i] in root.days: Rectangle {
        x: 4px + Math.mod(i, 7) * root.cw; y: 52px + Math.floor(i / 7) * 29px;
        width: root.cw; height: 29px;
        if d.day > 0: Rectangle {
            width: 28px; height: 25px; x: (root.cw - 28px) / 2; y: 2px; border-radius: 6px;
            background: d.selected ? Theme.accent : (cell.pressed && d.enabled) ? #ffffff24 : transparent;
            border-width: d.today && !d.selected ? 1px : 0px; border-color: #ffffff80;
            Text { text: d.day; color: d.selected ? #0b0f16 : d.enabled ? #ffffff : #ffffff40;
                   font-size: 13px; font-weight: d.selected ? 600 : 400;
                   horizontal-alignment: center; vertical-alignment: center; }
        }
        cell := TouchArea { enabled: d.enabled && d.day > 0; clicked => { root.day-picked(d.day); } }
    }
}

// Scrollable 00..count-1 list (hours, minutes, seconds).
export component NumberList inherits Rectangle {
    in property <int> count: 60;
    in property <int> current;
    callback picked(int);
    height: 150px;
    border-radius: 8px; border-width: 1px; border-color: #ffffff40; background: #232834;
    drop-shadow-blur: 16px; drop-shadow-color: #00000090;
    Flickable {
        width: parent.width; height: parent.height;
        content-height: root.count * 30px;
        content-y: -min(max(root.current * 30px - 60px, 0px), root.count * 30px - 150px);
        for i in root.count: Rectangle {
            y: i * 30px; height: 30px;
            background: i == root.current ? Theme.accent.with-alpha(0.35) : transparent;
            Text { text: i < 10 ? "0" + i : "" + i; color: #ffffff; font-size: 15px;
                   horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.picked(i); } }
        }
    }
}
